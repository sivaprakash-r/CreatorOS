# ---- Mesh API (mandatory — every LLM/AI call goes through it) ----
MESH_API_KEY=rsk_your_key_here
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_CHAT_MODEL=openai/gpt-4o-mini
MESH_EDITOR_MODEL=openai/gpt-4o-mini
MESH_IMAGE_MODEL=openai/gpt-image-1
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small
# Deterministic canned responses for offline tests ONLY. Never set this for a real run.
MESH_MOCK=0

# ---- Database (docker-compose sets this to Postgres; SQLite works for local dev) ----
DATABASE_URL=sqlite:///./data/creatoros.db
# DATABASE_URL=postgresql+psycopg://creatoros:creatoros@localhost:5432/creatoros

# ---- Pipeline ----
EDITOR_MAX_ROUNDS=2
EDITOR_PASS_SCORE=7.5

# ---- Scheduler / publishing ----
SCHEDULER_ENABLED=1
SCHEDULER_POLL_SECONDS=20
SIMULATE_ENGAGEMENT=1
# Optional: real posting to X / Twitter (API v2, OAuth 1.0a user context)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

LOG_LEVEL=INFO
